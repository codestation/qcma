FROM opensuse/tumbleweed:latest

ARG HOST_UID=1000
ARG HOST_GID=1000

RUN set -eux; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        cmake \
        ninja \
        desktop-file-utils \
        gcc \
        gcc-c++ \
        git \
        libavcodec-devel \
        libavformat-devel \
        libavutil-devel \
        libnotify-devel \
        qt6-base-devel \
        qt6-linguist-devel \
        qt6-tools-linguist \
        libswscale-devel \
        libusb-1_0-devel \
        libxml2-devel \
        make \
        pkg-config \
        rpm-build \
        rpmlint \
        shadow; \
    zypper clean --all; \
    group_name="$(getent group "$HOST_GID" | cut -d: -f1)"; \
    if [ -z "$group_name" ]; then groupadd --gid "$HOST_GID" builder; group_name=builder; fi; \
    user_name="$(getent passwd "$HOST_UID" | cut -d: -f1)"; \
    if [ -z "$user_name" ]; then useradd --uid "$HOST_UID" --gid "$group_name" --home-dir /home/builder --create-home builder; else mkdir -p /home/builder; chown "$HOST_UID:$HOST_GID" /home/builder; fi

USER ${HOST_UID}:${HOST_GID}
ENV HOME=/home/builder
