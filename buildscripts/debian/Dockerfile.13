FROM debian:13

ARG HOST_UID=1000
ARG HOST_GID=1000

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    autoconf automake build-essential debhelper devscripts dh-autoreconf dpkg-dev fakeroot file gettext git lintian sudo \
    libavcodec-dev libavformat-dev libavutil-dev libnotify-dev libswscale-dev libtool \
    libusb-1.0-0-dev libxml2-dev pkg-config qmake6 qt6-base-dev qt6-base-dev-tools qt6-l10n-tools \
    && rm -rf /var/lib/apt/lists/* \
    && group_name="$(getent group "$HOST_GID" | cut -d: -f1)" \
    && if [ -z "$group_name" ]; then groupadd --gid "$HOST_GID" builder; group_name=builder; fi \
    && user_name="$(getent passwd "$HOST_UID" | cut -d: -f1)" \
    && if [ -z "$user_name" ]; then useradd --uid "$HOST_UID" --gid "$group_name" --home-dir /home/builder --create-home builder; else mkdir -p /home/builder; chown "$HOST_UID:$HOST_GID" /home/builder; fi \
    && echo 'ALL ALL=(ALL) NOPASSWD: ALL' >/etc/sudoers.d/container-build \
    && chmod 0440 /etc/sudoers.d/container-build

USER ${HOST_UID}:${HOST_GID}
ENV HOME=/home/builder
